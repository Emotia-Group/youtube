__pycache__/
*.pyc
.env
projects/*
!projects/.gitkeep
data/
config.local.yaml
# TU MATERIAL PROPIO dentro de assets/ (música, efectos, ambientes y banco de
# elementos): vive en tu equipo, nunca se sube al repositorio. Sin esto, cada
# archivo tuyo aparecía como «cambio local» y la interfaz avisaba de algo que
# en realidad era normal.
assets/music/*
!assets/music/README.md
assets/sfx/*
!assets/sfx/README.md
!assets/sfx/ambientes/
assets/sfx/ambientes/*
!assets/sfx/ambientes/.gitkeep
assets/elements/*
!assets/elements/README.md
!assets/elements/*/
assets/elements/*/*
!assets/elements/*/.gitkeep
client_secrets.json
token.json
.venv/
predicciones.jsonl

# Artefactos que generan las baterías de prueba al correr (se rehacen solos)
tests/t*/
tests/thumbs_demo/
tests/__pycache__/
