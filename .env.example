ANTHROPIC_API_KEY=

# TTS / STT / imágenes (según proveedor elegido en config.yaml)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Imágenes FLUX, video generativo (Kling/Wan) y música (MusicGen)
REPLICATE_API_TOKEN=
